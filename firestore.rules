rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher() { return signedIn() && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid)) && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == "teacher"; }
    function isSessionMember(id) { return signedIn() && exists(/databases/$(database)/documents/sessions/$(id)/members/$(request.auth.uid)); }
    match /userRoles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /sessions/{id} {
      allow get: if isTeacher() || isSessionMember(id);
      allow list, create, update, delete: if false;
      match /members/{uid} { allow read, write: if false; }
      match /answerCounts/{answerId} { allow read: if isTeacher(); allow write: if false; }
    }
  }
}